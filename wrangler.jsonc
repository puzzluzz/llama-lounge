{
  // Llama Lounge: game page + accounts API + realtime room, all on one Worker
  "name": "llama-lounge",
  "main": "src/worker.js",
  // tests run before every deploy; if one fails, the deploy stops and the live game keeps the last good version
  "build": { "command": "node tests/run.mjs --build", "watch_dir": "src" },
  "compatibility_date": "2025-11-01",
  // the game's own domain (bought at Cloudflare). The old workers.dev address keeps working alongside it.
  "workers_dev": true,
  "routes": [ { "pattern": "llamalounge.club", "custom_domain": true }, { "pattern": "www.llamalounge.club", "custom_domain": true } ],
  "assets": { "directory": "./public", "not_found_handling": "single-page-application" },
  // email (confirm your email, password resets) is sent with Cloudflare Email Service from the game's own domain. No keys or passwords involved.
  // APP_URL is left unset on purpose: links use whichever address the player is on, and staff passkeys made on the old address keep working.
  "send_email": [ { "name": "EMAIL" } ],
  "vars": { "MAIL_FROM": "noreply@llamalounge.club" },
  "durable_objects": { "bindings": [ { "name": "LOUNGE", "class_name": "Lounge" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Lounge"] } ],
  "d1_databases": [
    { "binding": "DB", "database_name": "llama-lounge", "database_id": "a0730bf5-48cc-4c15-be61-860aff614308" },
    // where the twice-a-day backups go (the newest 4 are kept)
    { "binding": "BACKUP", "database_name": "llama-lounge-backups", "database_id": "7c9dd5df-3ce7-4137-80c3-bc848b2af923" }
  ],
  // back up the database at 5:23 and 17:23 UTC (12:23 am and 12:23 pm Eastern)
  "triggers": { "crons": ["23 5,17 * * *"] },
  "observability": { "enabled": true }
}
